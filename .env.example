# Copy to .env for local runs. Never commit .env. Every variable is optional.
APP_SERVICE_NAME=deterministic-agent-simulator
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENABLE_DOCS=false

# Comma-separated lowercase SHA-256 digests of API keys.
# Generate a key with: uv run deterministic-agent-simulator generate-api-key
APP_API_KEY_SHA256=
# Comma-separated explicit origins, e.g. https://app.example.com ("*" is refused).
APP_CORS_ALLOW_ORIGINS=
APP_RATE_LIMIT_PER_SECOND=5
APP_RATE_LIMIT_BURST=20
APP_RATE_LIMIT_MAX_CLIENTS=10000
APP_MAX_BODY_BYTES=1048576
APP_METRICS_REQUIRE_AUTH=true
APP_TRACING_EXPORTER=none

# Agentic kit. Tests, demo and bench run offline and never need a key.
ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-opus-5
APP_LLM_EFFORT=high
APP_LLM_MAX_RETRIES=2
APP_LLM_TIMEOUT_SECONDS=600
APP_LLM_REFUSAL_FALLBACK=true
APP_BUDGET_MAX_STEPS=50
APP_BUDGET_MAX_TOKENS=200000
APP_BUDGET_MAX_USD=1.0

# Simulator. Replay files are HMAC-signed with this key (at least 32 characters); without it
# campaigns still write redacted reports but no replay files. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_REPLAY_HMAC_KEY=
APP_REPLAY_KEY_ID=local
# Bug flags compiled into "the current build" that emitted regression tests replay against.
# Empty is the reference build with every control correct.
APP_SIM_BUG_FLAGS=
# Campaign caps: no campaign runs more seeds or longer than this, whatever it asks for.
APP_SIM_MAX_SEEDS=1000000
APP_SIM_MAX_WALL_SECONDS=21600
# Read-only results API: campaign summaries and repro files are served from here.
APP_RESULTS_DIR=var/results
# Scoped keys: comma-separated <sha256>=<scope>+<scope> (scopes: results:read, repros:verify).
APP_API_KEY_SCOPES=

APP_DATA_DIR=var
